{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/index?route=data"
    },
    {
      "source": "/api/refresh",
      "destination": "/api/index?route=refresh"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?route=page"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "30 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
